# RÉSULTATS-BF — modèle de configuration (versionné).
#
# Le vrai fichier .env n'est JAMAIS versionné (voir .gitignore).
# S'il est absent, le Vagrantfile le crée automatiquement à partir de ce
# modèle en remplaçant chaque __GENERE__ / __GENERE8__ par un secret aléatoire.
# Vous pouvez aussi le créer à la main : cp .env.exemple .env

# --- Paramètres de la plateforme -------------------------------------------
# Numéro de groupe attribué par l'enseignant : réseau 192.168.(56 + (G-1) mod 8).0/24
# (= 55+G pour les groupes 1 à 8). Groupe 10 -> 192.168.57.0/24
GROUPE=10
# Nombre de serveurs applicatifs (2 à 9). Peut être surchargé : NB_APP=4 vagrant up
NB_APP=2
# Extensions déployées : E1 (lb2 + VRRP), E2 (Prometheus/Grafana). Vide = socle seul.
EXTENSIONS=E1,E2
# Version épinglée de la boîte bento/ubuntu-24.04 (identique pour tout le groupe)
BOITE_VERSION=202510.26.0

# --- Secrets ----------------------------------------------------------------
# Mot de passe du rôle PostgreSQL utilisé par l'application
PG_MDP_APP=__GENERE__
# Mot de passe du rôle PostgreSQL de réplication
PG_MDP_REPLICATION=__GENERE__
# Mot de passe VRRP de keepalived (8 caractères au plus)
VRRP_MDP=__GENERE8__
# Mot de passe de l'administrateur Grafana
GRAFANA_MDP_ADMIN=__GENERE__
